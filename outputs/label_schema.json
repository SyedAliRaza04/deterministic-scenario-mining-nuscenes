{
  "schema_version": "C6.3",
  "n_tags": 37,
  "families": [
    "ego_maneuver",
    "interaction",
    "map_context",
    "visible_objects"
  ],
  "scopes": {
    "ego": "a fact about the ego vehicle itself",
    "map_containment": "the ego's own position on the HD map",
    "map_corridor_30m": "the 30 m x 8 m corridor ahead of the ego, along its heading",
    "camera_frustum_CAM_FRONT": "only what the CAM_FRONT frustum contains",
    "world_360": "every annotated agent, whether or not a camera sees it"
  },
  "categorical": {
    "lateral_label": [
      "going_straight",
      "turn_left",
      "turn_right",
      "u_turn"
    ],
    "longitudinal_label": [
      "cruising",
      "stationary",
      "accelerating",
      "decelerating"
    ]
  },
  "implications": [
    {
      "if": "traffic_cone",
      "then": "construction_object",
      "because": "a cone is one of the construction categories"
    },
    {
      "if": "barrier",
      "then": "construction_object",
      "because": "a barrier is one of the construction categories"
    },
    {
      "if": "moving_vehicle",
      "then": "has_vehicle",
      "because": "the attribute test also requires category vehicle.*"
    },
    {
      "if": "parked_vehicle",
      "then": "has_vehicle",
      "because": "same"
    },
    {
      "if": "stopped_vehicle",
      "then": "has_vehicle",
      "because": "same"
    },
    {
      "if": "large_vehicle",
      "then": "has_vehicle",
      "because": "the large categories are all vehicle.*"
    },
    {
      "if": "cyclist",
      "then": "has_vehicle",
      "because": "a two-wheeler is annotated as vehicle.bicycle/motorcycle"
    },
    {
      "if": "parked_bicycle",
      "then": "has_vehicle",
      "because": "same"
    },
    {
      "if": "vehicle_near",
      "then": "has_vehicle",
      "because": "the near tag is the presence tag plus a radius"
    },
    {
      "if": "pedestrian_near",
      "then": "has_pedestrian",
      "because": "same"
    },
    {
      "if": "lead_braking",
      "then": "lead_vehicle",
      "because": "there must be a lead for it to be braking"
    },
    {
      "if": "cut_in",
      "then": "lead_vehicle",
      "because": "an agent inside the corridor makes the corridor non-empty"
    },
    {
      "if": "on_ped_crossing",
      "then": "ped_crossing_ahead",
      "because": "the forward corridor starts at u=0, so a polygon containing the ego intersects it"
    },
    {
      "if": "on_stop_line",
      "then": "stop_line_ahead",
      "because": "same"
    },
    {
      "if": "at_intersection",
      "then": "intersection_ahead",
      "because": "same"
    }
  ],
  "prevalence_measured_on": {
    "split": "trainval",
    "n_frames": 34149
