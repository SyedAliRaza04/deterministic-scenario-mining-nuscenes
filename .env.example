# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# On Google Colab do NOT use this file. Use the Secrets tab (key icon, left sidebar)
# and read values with:
#   from google.colab import userdata
#   MOONDREAM_API_KEY = userdata.get("MOONDREAM_API_KEY")

# Moondream VLM API — free key at https://moondream.ai
MOONDREAM_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Only needed for reference/ceiling runs, not the main pipeline.
OPENAI_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens
# Needed for gated model weights (Qwen) and for DriveLM if used.
HF_TOKEN=

# Mistral — https://console.mistral.ai
# Optional; the SystemX brief lists Mistral as an approved LLM API.
MISTRAL_API_KEY=
